local contador = 0
local function prox() contador += 1 return contador end

local function secao(texto)
    criar("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = texto,
        TextColor3 = P.dim, Font = Enum.Font.GothamBold, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = prox(),
    }, scroll)
end

local function campo(texto, chave, minimo, maximo)
    local linha = criar("Frame", {
        Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = P.card,
        BorderSizePixel = 0, LayoutOrder = prox(),
    }, scroll)
    canto(linha, 8)
    criar("TextLabel", {
        Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1, Text = texto, TextColor3 = P.text,
        Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
    }, linha)
    local caixa = criar("TextBox", {
        Size = UDim2.fromOffset(80, 24), Position = UDim2.new(1, -90, 0.5, -12),
        BackgroundColor3 = P.input, Text = tostring(CONFIG[chave]), TextColor3 = P.text,
        Font = Enum.Font.GothamMedium, TextSize = 13, ClearTextOnFocus = false,
    }, linha)
    canto(caixa, 6)
    criar("UIStroke", {Color = P.stroke, Thickness = 1}, caixa)
    caixa.FocusLost:Connect(function()
        local n = tonumber(caixa.Text)
        if n then CONFIG[chave] = math.clamp(n, minimo, maximo) end
        caixa.Text = tostring(CONFIG[chave])
        salvarConfig()
    end)
end

local function toggle(texto, chave)
    local linha = criar("TextButton", {
        Size = UDim2.new(1, 0, 0, isMobile and 38 or 34), BackgroundColor3 = P.card,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = prox(),
    }, scroll)
    canto(linha, 8)
    criar("TextLabel", {
        Size = UDim2.new(1, -64, 1, 0), Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1, Text = texto, TextColor3 = P.text,
        Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
    }, linha)
    local trilho = criar("Frame", {
        Size = UDim2.fromOffset(36, 18), Position = UDim2.new(1, -46, 0.5, -9),
        BackgroundColor3 = P.off, BorderSizePixel = 0,
    }, linha)
    canto(trilho, 9)
    local bola = criar("Frame", {
        Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = P.dim, BorderSizePixel = 0,
    }, trilho)
    canto(bola, 7)
    local function atualizar(animar)
        local on = CONFIG[chave]
        local alvo = on and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
        if animar then
            TweenService:Create(bola, TweenInfo.new(0.15), {Position = alvo}):Play()
        else
            bola.Position = alvo
        end
        trilho.BackgroundColor3 = on and P.success or P.off
        bola.BackgroundColor3 = on and Color3.new(1, 1, 1) or P.dim
    end
    linha.MouseButton1Click:Connect(function()
        CONFIG[chave] = not CONFIG[chave]
        atualizar(true)
        salvarConfig()
    end)
    atualizar(false)
end

