local P = {
    bg = Color3.fromRGB(18, 18, 26), header = Color3.fromRGB(28, 28, 40),
    card = Color3.fromRGB(32, 32, 46), input = Color3.fromRGB(22, 22, 32),
    stroke = Color3.fromRGB(56, 56, 78), text = Color3.fromRGB(235, 235, 245),
    dim = Color3.fromRGB(140, 140, 165), accent = Color3.fromRGB(110, 125, 255),
    success = Color3.fromRGB(70, 190, 120), danger = Color3.fromRGB(225, 85, 85),
    warning = Color3.fromRGB(235, 185, 80), off = Color3.fromRGB(46, 46, 62),
}

local function criar(classe, props, pai)
    local o = Instance.new(classe)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = pai
    return o
end
local function canto(o, r) criar("UICorner", {CornerRadius = UDim.new(0, r)}, o) end

local gui = criar("ScreenGui", {
    Name = "VarrerGui", ResetOnSpawn = false, IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, (gethui and gethui()) or game:GetService("CoreGui"))

local LARGURA, ALTURA = 300, 480

local frame = criar("Frame", {
    Size = UDim2.fromOffset(LARGURA, ALTURA),
    BackgroundColor3 = P.bg, BorderSizePixel = 0, ClipsDescendants = true,
    AnchorPoint = isMobile and Vector2.new(0.5, 0.5) or Vector2.new(0, 0),
    Position = isMobile and UDim2.fromScale(0.5, 0.5) or UDim2.fromScale(0.04, 0.2),
}, gui)
canto(frame, 14)
criar("UIStroke", {Color = P.stroke, Thickness = 1}, frame)
local uiScale = criar("UIScale", {}, frame)

local header = criar("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = P.header, BorderSizePixel = 0}, frame)
criar("TextLabel", {
    Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(14, 0),
    BackgroundTransparency = 1, Text = "🧹  Varrer Locais", TextColor3 = P.text,
    Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left,
}, header)

local tamBtn = isMobile and 32 or 26
local minBtn = criar("TextButton", {
    Size = UDim2.fromOffset(tamBtn, tamBtn), Position = UDim2.new(1, -tamBtn - 8, 0.5, -tamBtn / 2),
    BackgroundColor3 = P.off, Text = "–", TextColor3 = P.text,
    Font = Enum.Font.GothamBold, TextSize = 18, AutoButtonColor = true,
}, header)
canto(minBtn, 7)

local fab = criar("TextButton", {
    Size = UDim2.fromOffset(54, 54), AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -18, 0, 70), BackgroundColor3 = P.accent,
    Text = "🧹", TextSize = 24, Font = Enum.Font.GothamBold,
    TextColor3 = Color3.new(1, 1, 1), Visible = false, AutoButtonColor = true,
}, gui)
canto(fab, 27)
local fabScale = criar("UIScale", {}, fab)

local function minimizar() frame.Visible = false fab.Visible = true end
local function reabrir() frame.Visible = true fab.Visible = false end
minBtn.MouseButton1Click:Connect(minimizar)
fab.MouseButton1Click:Connect(reabrir)

UserInputService.InputBegan:Connect(function(input, processado)
    if processado then return end
    if input.KeyCode == Enum.KeyCode.P then
        if frame.Visible then minimizar() else reabrir() end
    end
end)

local function updateScale()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local s
    if isMobile then
        s = math.clamp(math.min(vp.X * 0.75, 360) / LARGURA, 0.75, 1.2)
        s = math.min(s, (vp.Y * 0.9) / ALTURA)
    else
        s = math.clamp(math.min(vp.X, vp.Y) / 900, 0.9, 1.25)
    end
    uiScale.Scale = s
    fabScale.Scale = math.max(s, 0.9)
end
updateScale()
task.spawn(function()
    local cam = workspace.CurrentCamera or workspace:WaitForChild("Camera")
    cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
    updateScale()
end)

local arrastando, inicioArraste, posInicial = false, nil, nil
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = true
        inicioArraste = input.Position
        posInicial = frame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not arrastando then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - inicioArraste
        frame.Position = UDim2.new(posInicial.X.Scale, posInicial.X.Offset + d.X,
            posInicial.Y.Scale, posInicial.Y.Offset + d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = false
    end
end)

