secao("LUGARES  (toque pra ligar/desligar · o 1 é sempre o último)")
local chipsFrame = criar("Frame", {
    Size = UDim2.new(1, 0, 0, 76), BackgroundTransparency = 1, LayoutOrder = prox(),
}, scroll)
criar("UIGridLayout", {
    CellSize = UDim2.fromOffset(46, 34), CellPadding = UDim2.fromOffset(6, 6),
    SortOrder = Enum.SortOrder.LayoutOrder,
}, chipsFrame)

local chips = {}
local function pintarChip(id)
    local c = chips[id]
    if not c then return end
    if atualId == id then
        c.BackgroundColor3 = P.accent
        c.TextColor3 = Color3.new(1, 1, 1)
    elseif ATIVOS[id] then
        c.BackgroundColor3 = P.success
        c.TextColor3 = Color3.new(1, 1, 1)
    else
        c.BackgroundColor3 = P.off
        c.TextColor3 = P.dim
    end
end

for id = 1, 9 do
    local c = criar("TextButton", {
        BackgroundColor3 = P.off, Text = tostring(id), TextColor3 = P.text,
        Font = Enum.Font.GothamBold, TextSize = 14, AutoButtonColor = false,
        BorderSizePixel = 0, LayoutOrder = id,
    }, chipsFrame)
    canto(c, 8)
    chips[id] = c
    c.MouseButton1Click:Connect(function()
        ATIVOS[id] = not ATIVOS[id]
        pintarChip(id)
        salvarConfig()
    end)
    pintarChip(id)
end

marcarAtual = function()
    for id = 1, 9 do pintarChip(id) end
end

local botao = criar("TextButton", {
    Size = UDim2.new(1, -20, 0, 48), Position = UDim2.new(0, 10, 1, -58),
    BackgroundColor3 = P.success, Text = "▶  INICIAR", TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.GothamBold, TextSize = 15, AutoButtonColor = true,
}, frame)
canto(botao, 10)

resetBotao = function()
    botao.Text = "▶  INICIAR"
    botao.BackgroundColor3 = P.success
end

botao.MouseButton1Click:Connect(function()
    rodando = not rodando
    if rodando then
        botao.Text = "■  PARAR"
        botao.BackgroundColor3 = P.danger
        setStatus("Iniciando...", "accent")
        iniciar()
    else
        resetBotao()
        setStatus("Parando...", "warning")
    end
end)

setStatus("Parado", "dim")
atualizarStats()
log("script v5 carregado | anti-afk=%s | remote base=%s",
    tostring(CONFIG.AntiAFK),
    tostring(RemoteBase and RemoteBase:GetFullName() or "nil"))
