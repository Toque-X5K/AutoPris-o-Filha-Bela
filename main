--// Varrer Locais v5 | Fly + RemoteVarrer por lugar + Anti-AFK + GUI universal
-- v5: cada lugar usa seu próprio remote (RemoteVarrerN), com fallback pro base + anti-AFK
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local VirtualUser = game:GetService("VirtualUser")

local player = Players.LocalPlayer
local LocaisFolder = workspace:WaitForChild("LocaisVarrer")
local RemoteBase = ReplicatedStorage:FindFirstChild("RemoteVarrer")

local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

--// CONFIG
local CONFIG = {
    Speed = 120,
    HipHeight = 3,
    Noclip = true,
    StayOnGround = true,
    EmPe = true,
    RequireSuccess = true,
    Repetir = true,
    WaitAfterFire = 3,
    SuccessTimeout = 4,
    MaxRetries = 3,
    TimeoutVoo = 20,
    SuccessKeyword = "success",
    Log = true,
    Jitter = 0.3,
    OrdemAleatoria = false,
    UsarCFReal = false,
    AntiAFK = true,
}

--// LOCAIS
local function C(x, y, z)
    return CFrame.new(x, y, z, 0.606805265, -0, -0.794850528, 0, 1, -0, 0.794850528, 0, 0.606805265)
end
local function idx(n) return function() return LocaisFolder:GetChildren()[n] end end

local LOCAIS = {
    [1] = {cf = C(3972.59058, 62.5330582, 4102.49609), alvo = function() return LocaisFolder:FindFirstChild("Part") end},
    [2] = {cf = C(3817.31299, 62.5330582, 4139.19336), alvo = idx(2)},
    [3] = {cf = C(3893.20215, 62.5330582, 4081.25659), alvo = idx(3)},
    [4] = {cf = C(3882.15698, 62.5330582, 4174.66064), alvo = idx(4)},
    [5] = {cf = C(3881.06006, 62.5330582, 3993.31226), alvo = idx(5)},
    [6] = {cf = C(3786.67749, 62.5330582, 4199.70752), alvo = idx(6)},
    [7] = {cf = C(3755.79199, 62.5330582, 4088.94678), alvo = idx(7)},
    [8] = {cf = C(3948.81494, 62.5330582, 4038.79956), alvo = idx(8)},
    [9] = {cf = C(3823.64331, 62.5330582, 4052.56201), alvo = idx(9)},
}
local ORDEM = {2, 3, 4, 5, 6, 7, 8, 9, 1}

local ATIVOS = {}
for i = 1, 9 do ATIVOS[i] = true end

--// PERSISTÊNCIA
local CONFIG_FILE = "varrer_config.json"

local function salvarConfig()
    if type(writefile) ~= "function" then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode({CONFIG = CONFIG, ATIVOS = ATIVOS, ORDEM = ORDEM}))
    end)
end

local function carregarConfig()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
    pcall(function()
        if not isfile(CONFIG_FILE) then return end
        local txt = readfile(CONFIG_FILE)
        if not txt or txt == "" then return end
        local dados = HttpService:JSONDecode(txt)
        if type(dados.CONFIG) == "table" then
            for k, v in pairs(dados.CONFIG) do
                if CONFIG[k] ~= nil and type(v) == type(CONFIG[k]) then CONFIG[k] = v end
            end
        end
        if type(dados.ATIVOS) == "table" then
            for i = 1, 9 do
                if type(dados.ATIVOS[i]) == "boolean" then ATIVOS[i] = dados.ATIVOS[i] end
            end
        end
        if type(dados.ORDEM) == "table" and #dados.ORDEM == 9 then ORDEM = dados.ORDEM end
    end)
end
carregarConfig()

--// ESTADO
local rodando = false
local successFlag = false
local alvoPos, destinoCF, segurarCF = nil, nil, nil
local hipOriginal = nil
local bv = nil
local atualId = nil
local stats = {ok = 0, falhas = 0, ciclos = 0}

local setStatus = function() end
local atualizarStats = function() end
local marcarAtual = function() end
local resetBotao = function() end

local function log(fmt, ...)
    if CONFIG.Log then print("[Varrer] " .. string.format(fmt, ...)) end
end

--// ANTI-AFK
player.Idled:Connect(function()
    if CONFIG.AntiAFK == false then return end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
    log("anti-afk: Idled disparado (reset)")
end)

task.spawn(function()
    while true do
        task.wait(15 * 60)
        if CONFIG.AntiAFK == false then continue end
        pcall(function()
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if hum and root then
                local cf = root.CFrame
                hum.Jump = true
                task.wait(0.1)
                root.CFrame = cf
            end
        end)
        log("anti-afk: heartbeat 15min")
    end
end)

--// RESOLUÇÃO DE REMOTE POR LUGAR
local RemoteCache = {}
local function getRemote(id)
    if RemoteCache[id] then return RemoteCache[id] end
    local candidatos = {
        "RemoteVarrer" .. id,
        "RemoteVarrer_" .. id,
        "Varrer" .. id,
        "Varrer_" .. id,
    }
    for _, nome in ipairs(candidatos) do
        local r = ReplicatedStorage:FindFirstChild(nome)
        if r and r:IsA("RemoteEvent") then
            RemoteCache[id] = r
            log("lugar %d → remote '%s'", id, nome)
            return r
        end
    end
    if RemoteBase and RemoteBase:IsA("RemoteEvent") then
        RemoteCache[id] = RemoteBase
        log("lugar %d → remote base (fallback) - NENHUM RemoteVarrer%d encontrado", id, id)
        return RemoteBase
    end
    log("lugar %d → NENHUM remote disponível!", id)
    return nil
end

--// DETECÇÃO DE SUCCESS
local function hookSuccess(r)
    if not r or not r:IsA("RemoteEvent") then return end
    if r:GetAttribute("__VarrerHooked") then return end
    r:SetAttribute("__VarrerHooked", true)
    pcall(function()
        r.OnClientEvent:Connect(function(...)
            for _, v in ipairs({...}) do
                if type(v) == "string" and string.find(string.lower(v), CONFIG.SuccessKeyword, 1, true) then
                    successFlag = true
                end
            end
        end)
    end)
end

for _, obj in ipairs(ReplicatedStorage:GetChildren()) do
    if obj:IsA("RemoteEvent") and (obj.Name:match("^RemoteVarrer") or obj.Name:match("^Varrer")) then
        hookSuccess(obj)
    end
end
ReplicatedStorage.ChildAdded:Connect(function(obj)
    if obj:IsA("RemoteEvent") and (obj.Name:match("^RemoteVarrer") or obj.Name:match("^Varrer")) then
        hookSuccess(obj)
    end
end)

local function checarTexto(obj)
    if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Visible then
        if string.find(string.lower(obj.Text), CONFIG.SuccessKeyword, 1, true) then
            successFlag = true
        end
    end
end

local function observar(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        checarTexto(obj)
        obj:GetPropertyChangedSignal("Text"):Connect(function() checarTexto(obj) end)
    end
end

local playerGui = player:WaitForChild("PlayerGui")
playerGui.DescendantAdded:Connect(function(obj) task.defer(observar, obj) end)

task.spawn(function()
    local t0 = tick()
    local achou = false
    while not achou and tick() - t0 < 30 do
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj.Name == "Notification" and obj:IsA("RemoteEvent") then
                obj.OnClientEvent:Connect(function(tipo)
                    if type(tipo) == "string" and tipo:lower() == CONFIG.SuccessKeyword then
                        successFlag = true
                    end
                end)
                achou = true
            end
        end
        if not achou then task.wait(1) end
    end
end)

local function esperarSuccess()
    local t0 = tick()
    while tick() - t0 < CONFIG.SuccessTimeout do
        if successFlag then return true end
        task.wait(0.05)
    end
    return false
end

--// NOCLIP
local function restaurarColisao()
    local char = player.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and not p:FindFirstAncestorOfClass("Accessory") then
                p.CanCollide = true
            end
        end
    end
end

RunService.Stepped:Connect(function()
    if rodando and CONFIG.Noclip then
        local char = player.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end
end)

--// FLY
local function garantirBV(root)
    if not bv or bv.Parent ~= root then
        if bv then bv:Destroy() end
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.zero
        bv.Parent = root
    end
end

local function limparBV()
    if bv then bv:Destroy() bv = nil end
end

RunService.Heartbeat:Connect(function(dt)
    if not rodando then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (root and hum) then return end

    if hum.HipHeight ~= CONFIG.HipHeight then hum.HipHeight = CONFIG.HipHeight end

    if alvoPos or segurarCF then
        hum.PlatformStand = not CONFIG.EmPe
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if CONFIG.EmPe then garantirBV(root) else limparBV() end
    end

    if segurarCF then
        root.CFrame = segurarCF
    elseif alvoPos then
        local pos = root.Position
        if CONFIG.StayOnGround then pos = Vector3.new(pos.X, alvoPos.Y, pos.Z) end
        local delta = alvoPos - pos
        local dist = delta.Magnitude
        if dist <= 0.6 then
            alvoPos = nil
            segurarCF = destinoCF
            root.CFrame = destinoCF
        else
            local passo = math.min(CONFIG.Speed * dt, dist)
            local novaPos = pos + delta.Unit * passo
            root.CFrame = CFrame.new(novaPos) * (root.CFrame - root.CFrame.Position)
        end
    end
end)

local function getCFPara(id)
    local dados = LOCAIS[id]
    local base = dados.cf
    if CONFIG.UsarCFReal then
        local alvo = dados.alvo()
        if alvo and alvo:IsA("BasePart") then
            base = alvo.CFrame
        else
            log("lugar %d: parte não encontrada, usando CFrame fixo", id)
        end
    end
    local j = CONFIG.Jitter or 0
    if j > 0 then
        base = base + Vector3.new(
            (math.random() * 2 - 1) * j,
            (math.random() * 2 - 1) * j * 0.3,
            (math.random() * 2 - 1) * j
        )
    end
    return base
end

local function voarPara(cf)
    segurarCF = nil
    destinoCF = cf + Vector3.new(0, CONFIG.HipHeight, 0)
    alvoPos = destinoCF.Position
    local t0 = tick()
    while rodando and alvoPos and tick() - t0 < CONFIG.TimeoutVoo do task.wait() end
    return alvoPos == nil
end

local function pararMovimento()
    alvoPos, destinoCF, segurarCF = nil, nil, nil
    limparBV()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
        if hipOriginal ~= nil then hum.HipHeight = hipOriginal end
    end
    hipOriginal = nil
    restaurarColisao()
end

--// VARRER
local function varrerLocal(id)
    local dados = LOCAIS[id]
    atualId = id
    marcarAtual()

    for tentativa = 1, CONFIG.MaxRetries do
        if not rodando then return false end
        successFlag = false

        setStatus(("Voando → lugar %d (tentativa %d)"):format(id, tentativa), "accent")
        log("lugar %d: voando (tentativa %d)", id, tentativa)
        if not voarPara(getCFPara(id)) then
            setStatus(("Lugar %d: não chegou"):format(id), "warning")
            log("lugar %d: timeout de voo", id)
        else
            local alvo = dados.alvo()
            if not alvo then
                setStatus(("Lugar %d: alvo não encontrado"):format(id), "danger")
                stats.falhas += 1
                atualizarStats()
                log("lugar %d: ALVO nil, abortando", id)
                return false
            end

            local remote = getRemote(id)
            if not remote then
                setStatus(("Lugar %d: remote inexistente"):format(id), "danger")
                stats.falhas += 1
                atualizarStats()
                log("lugar %d: sem remote, abortando", id)
                return false
            end

            setStatus(("Varrendo lugar %d → %s"):format(id, remote.Name), "accent")
            log("lugar %d: %s:FireServer(%s)", id, remote.Name, tostring(alvo))
            remote:FireServer(alvo)
            task.wait(CONFIG.WaitAfterFire)

            if not CONFIG.RequireSuccess then
                setStatus(("Lugar %d: ok"):format(id), "success")
                stats.ok += 1
                atualizarStats()
                return true
            end
            if esperarSuccess() then
                setStatus(("Lugar %d: success ✔"):format(id), "success")
                stats.ok += 1
                atualizarStats()
                log("lugar %d: SUCCESS", id)
                return true
            end
            log("lugar %d: sem success na tentativa %d", id, tentativa)
        end
    end

    setStatus(("Lugar %d: pulando (sem success)"):format(id), "warning")
    stats.falhas += 1
    atualizarStats()
    return false
end

local function contarAtivos()
    local n = 0
    for i = 1, 9 do if ATIVOS[i] then n += 1 end end
    return n
end

local function montarOrdem()
    local lista = {}
    for i = 1, #ORDEM do lista[i] = ORDEM[i] end
    if CONFIG.OrdemAleatoria then
        for i = #lista, 2, -1 do
            local j = math.random(i)
            lista[i], lista[j] = lista[j], lista[i]
        end
    end
    return lista
end

local function iniciar()
    task.spawn(function()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hipOriginal == nil then hipOriginal = hum.HipHeight end

        while rodando do
            if contarAtivos() == 0 then
                setStatus("Nenhum lugar ativado", "danger")
                rodando = false
                break
            end

            local ordem = montarOrdem()
            log("ciclo %d | ordem: [%s]", stats.ciclos + 1, table.concat(ordem, ","))

            for _, id in ipairs(ordem) do
                if not rodando then break end
                if ATIVOS[id] then varrerLocal(id) end
            end

            if rodando then
                stats.ciclos += 1
                atualizarStats()
                if not CONFIG.Repetir then rodando = false end
            end
        end

        pararMovimento()
        atualId = nil
        marcarAtual()
        setStatus("Parado", "dim")
        resetBotao()
        log("parado | ok=%d falhas=%d ciclos=%d", stats.ok, stats.falhas, stats.ciclos)
    end)
end

