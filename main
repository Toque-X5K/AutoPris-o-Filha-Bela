local function statBox(legenda, cor, ordem)
    local box = criar("Frame", {
        Size = UDim2.new(1 / 3, -4, 1, 0), BackgroundColor3 = P.card,
        BorderSizePixel = 0, LayoutOrder = ordem,
    }, statsRow)
    canto(box, 8)
    local valor = criar("TextLabel", {
        Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 4),
        BackgroundTransparency = 1, Text = "0", TextColor3 = cor,
        Font = Enum.Font.GothamBold, TextSize = 17,
    }, box)
    criar("TextLabel", {
        Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 27),
        BackgroundTransparency = 1, Text = legenda, TextColor3 = P.dim,
        Font = Enum.Font.Gotham, TextSize = 10,
    }, box)
    return valor
end

